generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum LocationStatus {
  AVAILABLE
  AVAILABLE_FROM
  BOOKED
  RESERVED
  UNKNOWN
}

enum LocationLifecycleStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  MAINTENANCE
}

enum LocationAvailabilityOverrideType {
  COMMERCIAL_BLOCK
  MAINTENANCE
  INTERNAL_HOLD
}

enum GpsAuditStatus {
  OK
  CORRECTED
  MISSING
  NEEDS_CONFIRMATION
  SUSPECT
}

enum ReservationStatus {
  HOLD
  RESERVED
  BOOKED
  CANCELLED
  EXPIRED
}

enum OfferRequestStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
  ARCHIVED
}

enum UserRole {
  SUPER_ADMIN
  COO
  SALES_DIRECTOR
  SALES_AGENT
  FINANCE_OPERATOR
  FIELD_OPERATOR
}

enum OperationTaskKind {
  DECORATION
  NEUTRALIZATION
  REDECORATION
  MAINTENANCE
}

enum OperationTaskStatus {
  NEW
  IN_PROGRESS
  DONE
  ARCHIVED
  CANCELLED
}

enum OperationTaskSource {
  SYSTEM_DERIVED
  LEGACY_PRODUCTION_NOTES
  MANUAL
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?    @db.Text
  sortOrder   Int        @default(0)
  locations   Location[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("portfolio_categories")
}

model Location {
  id                         String          @id @default(cuid())
  nr                         String?
  code                       String          @unique
  categoryId                 String
  city                       String?
  county                     String?
  address                    String?         @db.Text
  type                       String?
  size                       String?
  sqm                        Float?
  illum                      Boolean?
  rateCard                   String?
  rateCardValue              Float?
  installationRemoval        String?
  installationRemovalValue   Float?
  availabilityText           String?
  availableFrom              DateTime?
  availableUntil             DateTime?
  bookedFrom                 DateTime?
  bookedUntil                DateTime?
  status                     LocationStatus  @default(UNKNOWN)
  lifecycleStatus            LocationLifecycleStatus @default(ACTIVE)
  latReal                    Float?
  lngReal                    Float?
  latDisplay                 Float?
  lngDisplay                 Float?
  mapsUrl                    String?         @db.Text
  mainPhotoUrl               String?         @db.Text
  photoOriginalUrl           String?         @db.Text
  showPricePublic            Boolean         @default(false)
  showInstallationCostPublic Boolean         @default(false)
  showInPublic               Boolean         @default(true)
  isPremium                  Boolean         @default(false)
  isFeatured                 Boolean         @default(false)
  normalizedLocationName     String?
  reportingGroupName         String?
  displayOrder               Int?
  locationGroupOrder         Int?
  faceOrder                  Int?
  directionOrder             Int?
  monthlyCost                Float?
  costCurrency               String?         @db.VarChar(3)
  costType                   String?
  costSupplier               String?
  costNotes                  String?         @db.Text
  blockedReason              String?         @db.Text
  blockedByUserId            String?
  blockedFrom                DateTime?
  blockedUntil               DateTime?
  blockedNotes               String?         @db.Text
  coordinateSource           String?
  gpsAuditStatus             GpsAuditStatus  @default(NEEDS_CONFIRMATION)
  benefits                   Json?
  mediaDetails               Json?
  campaignDetails            Json?
  internalNotes              String?         @db.Text
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  category Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  blockedBy User?        @relation("LocationBlockedBy", fields: [blockedByUserId], references: [id], onDelete: SetNull)
  images   Image[]
  audits   GpsAuditLog[]
  reservations Reservation[]
  availabilityOverrides LocationAvailabilityOverride[]
  operationTasks OperationTask[]
  financialImportRows FinancialReceivableImportRow[]

  @@index([categoryId])
  @@index([status])
  @@index([lifecycleStatus])
  @@index([city])
  @@index([showInPublic])
  @@index([gpsAuditStatus])
  @@index([reportingGroupName])
  @@index([displayOrder])
  @@index([locationGroupOrder])
  @@index([blockedByUserId])
  @@map("portfolio_locations")
}

model LocationAvailabilityOverride {
  id              String                           @id @default(cuid())
  locationId      String
  type            LocationAvailabilityOverrideType @default(COMMERCIAL_BLOCK)
  reason          String                           @db.Text
  periodStart     DateTime
  periodEnd       DateTime?
  notes           String?                          @db.Text
  createdByUserId String?
  clearedByUserId String?
  clearedAt       DateTime?
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt

  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("LocationAvailabilityOverrideCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  clearedBy User?    @relation("LocationAvailabilityOverrideClearedBy", fields: [clearedByUserId], references: [id], onDelete: SetNull)

  @@index([locationId, periodStart, periodEnd], map: "loc_avail_override_period_idx")
  @@index([type], map: "loc_avail_override_type_idx")
  @@index([clearedAt], map: "loc_avail_override_cleared_idx")
  @@index([createdByUserId], map: "loc_avail_override_created_by_idx")
  @@index([clearedByUserId], map: "loc_avail_override_cleared_by_idx")
  @@map("portfolio_location_availability_overrides")
}

model Reservation {
  id              String            @id @default(cuid())
  locationId      String
  clientId        String?
  campaignId      String?
  status          ReservationStatus @default(RESERVED)
  clientName      String
  clientCompany   String?
  contractCompany String?
  clientEmail     String?
  clientPhone     String?
  campaignName    String?
  contractNumber  String?
  salesperson     String?
  notes           String?           @db.Text
  productionNotes String?           @db.Text
  amount          Float?
  monthlyRentTotal Float?
  monthlyRentShare Float?
  contractGroupId String?
  periodStart     DateTime
  periodEnd       DateTime
  installationDate DateTime?
  neutralizationDate DateTime?
  externalSource  String?
  externalId      String?           @unique
  bookedAt        DateTime?
  holdExpiresAt   DateTime?
  ownerId         String?
  sellerUserId    String?
  currency        String?           @db.VarChar(3)
  paymentTermType String?
  paymentTermDays Int?
  customPaymentTermNote String?     @db.Text
  billingRule     String?
  billingDayOfMonth Int?
  customBillingDate DateTime?
  billingFrequency String?
  invoiceGenerationMode String?
  nextInvoiceDate DateTime?
  billingNotes    String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  client   ClientAccount? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  owner    User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  sellerUser User?  @relation("ReservationSeller", fields: [sellerUserId], references: [id], onDelete: SetNull)
  billingItems BillingItem[]
  documents ClientDocument[] @relation("ReservationDocuments")
  priceSegments RentalPriceSegment[]
  changeLogs RentalChangeLog[]
  operationTasks OperationTask[]

  @@index([locationId])
  @@index([clientId])
  @@index([campaignId])
  @@index([status])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([clientName])
  @@index([contractGroupId])
  @@index([installationDate])
  @@index([neutralizationDate])
  @@index([bookedAt])
  @@index([holdExpiresAt])
  @@index([ownerId])
  @@index([sellerUserId])
  @@index([nextInvoiceDate])
  @@map("portfolio_reservations")
}

model OfferRequest {
  id                  String             @id @default(cuid())
  status              OfferRequestStatus @default(NEW)
  clientName          String
  company             String?
  email               String?
  phone               String?
  message             String?            @db.Text
  selectedLocationIds Json
  selectedCodes       String?            @db.Text
  source              String?            @db.Text
  ownerId             String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([ownerId])
  @@map("portfolio_offer_requests")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(SALES_AGENT)
  active       Boolean  @default(true)
  tokenVersion Int      @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reservations  Reservation[]
  soldReservations Reservation[] @relation("ReservationSeller")
  offerRequests OfferRequest[]
  auditLogs     AuditLog[]
  blockedLocations Location[] @relation("LocationBlockedBy")
  financialUploads FinancialReportUpload[]
  resolvedFinancialIssues FinancialImportIssue[] @relation("FinancialIssueResolver")
  reviewedFinancialPayables FinancialPayable[] @relation("FinancialPayableReviewer")
  reviewedFinancialReceivables FinancialReceivable[] @relation("FinancialReceivableReviewer")
  resolvedReceivableImportRows FinancialReceivableImportRow[] @relation("FinancialReceivableImportRowResolver")
  createdReceivablePayments FinancialReceivablePayment[] @relation("FinancialReceivablePaymentCreator")
  cancelledReceivablePayments FinancialReceivablePayment[] @relation("FinancialReceivablePaymentCanceller")
  createdFinancialClientAliases FinancialClientAlias[] @relation("FinancialClientAliasCreator")
  createdFinancialClientCredits FinancialClientCredit[] @relation("FinancialClientCreditCreator")
  assignedCrmLeads CrmLead[] @relation("CrmLeadAssignee")
  createdCrmLeads CrmLead[] @relation("CrmLeadCreator")
  crmActivities CrmActivity[]
  ownedClients ClientAccount[] @relation("ClientAccountOwner")
  createdClients ClientAccount[] @relation("ClientAccountCreator")
  notifications AppNotification[]
  reviewedNotifications AppNotification[] @relation("NotificationResolver")
  uploadedDocuments ClientDocument[] @relation("DocumentUploader")
  createdAvailabilityOverrides LocationAvailabilityOverride[] @relation("LocationAvailabilityOverrideCreatedBy")
  clearedAvailabilityOverrides LocationAvailabilityOverride[] @relation("LocationAvailabilityOverrideClearedBy")
  ownedCampaigns Campaign[] @relation("CampaignAccountOwner")
  soldCampaigns Campaign[] @relation("CampaignSeller")
  createdCampaigns Campaign[] @relation("CampaignCreator")
  createdRentalPriceSegments RentalPriceSegment[]
  createdRentalChangeLogs RentalChangeLog[]
  ownedCrmCompanies CrmCompany[] @relation("CrmCompanyOwner")
  createdCrmCompanies CrmCompany[] @relation("CrmCompanyCreator")
  createdCrmCompanyContacts CrmCompanyContact[] @relation("CrmCompanyContactCreator")
  ownedCrmProspects CrmProspect[] @relation("CrmProspectOwner")
  createdCrmProspects CrmProspect[] @relation("CrmProspectCreator")
  ownedCrmOpportunities CrmOpportunity[] @relation("CrmOpportunityOwner")
  createdCrmOpportunities CrmOpportunity[] @relation("CrmOpportunityCreator")
  ownedCrmNextActions CrmNextAction[] @relation("CrmNextActionOwner")
  createdCrmNextActions CrmNextAction[] @relation("CrmNextActionCreator")
  completedCrmNextActions CrmNextAction[] @relation("CrmNextActionCompleter")
  crmDomainEvents CrmEvent[] @relation("CrmEventActor")
  createdSuppliers Supplier[] @relation("SupplierCreator")
  assignedOperationTasks OperationTask[] @relation("OperationTaskAssignee")
  createdOperationTasks OperationTask[] @relation("OperationTaskCreator")

  @@index([role])
  @@index([active])
  @@map("portfolio_users")
}

model ClientAccount {
  id                 String   @id @default(cuid())
  companyName        String
  normalizedName     String?
  clientType         String   @default("direct_client")
  taxId              String?
  registryNumber     String?
  billingAddress     String?  @db.Text
  generalEmail       String?
  generalPhone       String?
  website            String?
  accountOwnerUserId String?
  status             String   @default("prospect")
  notes              String?  @db.Text
  mergedIntoClientId String?
  mergedAt           DateTime?
  aliases            Json?
  createdByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  accountOwner User? @relation("ClientAccountOwner", fields: [accountOwnerUserId], references: [id], onDelete: SetNull)
  createdBy User? @relation("ClientAccountCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  contacts ClientContact[]
  reservations Reservation[]
  campaigns Campaign[]
  crmLeads CrmLead[]
  billingItems BillingItem[]
  financialReceivables FinancialReceivable[]
  financialImportRows FinancialReceivableImportRow[]
  financialAliases FinancialClientAlias[]
  financialCredits FinancialClientCredit[]
  documents ClientDocument[] @relation("ClientDocuments")

  @@index([normalizedName])
  @@index([clientType])
  @@index([accountOwnerUserId])
  @@index([status])
  @@index([mergedIntoClientId])
  @@map("portfolio_client_accounts")
}

model Campaign {
  id                    String   @id @default(cuid())
  clientId              String
  campaignName          String
  campaignCode          String?
  status                String   @default("draft")
  campaignType          String   @default("direct_client")
  agencyClientId        String?
  endClientId           String?
  accountOwnerUserId    String?
  sellerUserId          String?
  createdByUserId       String?
  companyEntity         String?
  startDate             DateTime?
  endDate               DateTime?
  currency              String?  @db.VarChar(3)
  totalContractValue    Decimal? @db.Decimal(14, 2)
  paymentTermType       String?
  paymentTermDays       Int?
  customPaymentTermNote String?  @db.Text
  billingRule           String?
  billingFrequency      String?
  billingNotes          String?  @db.Text
  notes                 String?  @db.Text
  archivedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  client ClientAccount @relation(fields: [clientId], references: [id], onDelete: Restrict)
  accountOwner User? @relation("CampaignAccountOwner", fields: [accountOwnerUserId], references: [id], onDelete: SetNull)
  sellerUser User? @relation("CampaignSeller", fields: [sellerUserId], references: [id], onDelete: SetNull)
  createdBy User? @relation("CampaignCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reservations Reservation[]
  receivables FinancialReceivable[]
  receivableImportRows FinancialReceivableImportRow[]
  documents ClientDocument[] @relation("CampaignDocuments")
  operationTasks OperationTask[]

  @@index([clientId])
  @@index([status])
  @@index([archivedAt])
  @@index([accountOwnerUserId])
  @@index([sellerUserId])
  @@index([createdByUserId])
  @@index([companyEntity])
  @@index([startDate])
  @@index([endDate])
  @@map("portfolio_campaigns")
}

model RentalPriceSegment {
  id              String   @id @default(cuid())
  rentalId        String
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  monthlyRent     Decimal  @db.Decimal(14, 2)
  currency        String   @db.VarChar(3)
  reason          String?  @db.Text
  createdByUserId String?
  createdAt       DateTime @default(now())

  rental Reservation @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([rentalId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@index([createdByUserId])
  @@map("portfolio_rental_price_segments")
}

model RentalChangeLog {
  id              String   @id @default(cuid())
  rentalId        String
  action          String
  previousJson    Json?
  nextJson        Json?
  note            String?  @db.Text
  createdByUserId String?
  createdAt       DateTime @default(now())

  rental Reservation @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([rentalId])
  @@index([action])
  @@index([createdByUserId])
  @@index([createdAt])
  @@map("portfolio_rental_change_logs")
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  email     String?
  phone     String?
  role      String?
  isPrimary Boolean  @default(false)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([email])
  @@map("portfolio_client_contacts")
}

model FinancialReportUpload {
  id               String   @id @default(cuid())
  uploadedByUserId String?
  uploadedAt       DateTime @default(now())
  reportDate       DateTime?
  originalFileName String
  fileHash         String
  status           String   @default("uploaded")
  errorSummary     String?  @db.Text
  activeVersion    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  uploadedBy User? @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  companySnapshots FinancialReportCompanySnapshot[]
  payables FinancialPayable[]
  receivables FinancialReceivable[]
  issues FinancialImportIssue[]
  receivableImportRows FinancialReceivableImportRow[]

  @@index([uploadedByUserId])
  @@index([reportDate])
  @@index([status])
  @@index([activeVersion])
  @@index([fileHash])
  @@map("portfolio_financial_report_uploads")
}

model FinancialReportCompanySnapshot {
  id                  String   @id @default(cuid())
  uploadId            String
  companyName         String
  companyCode         String?
  totalPayable        Decimal  @default(0) @db.Decimal(14, 2)
  totalPaid           Decimal  @default(0) @db.Decimal(14, 2)
  remainingPayable    Decimal  @default(0) @db.Decimal(14, 2)
  totalReceivable     Decimal  @default(0) @db.Decimal(14, 2)
  totalCollected      Decimal  @default(0) @db.Decimal(14, 2)
  remainingReceivable Decimal  @default(0) @db.Decimal(14, 2)
  totalPayableRon        Decimal @default(0) @db.Decimal(14, 2)
  totalPayableEur        Decimal @default(0) @db.Decimal(14, 2)
  totalPaidRon           Decimal @default(0) @db.Decimal(14, 2)
  totalPaidEur           Decimal @default(0) @db.Decimal(14, 2)
  remainingPayableRon    Decimal @default(0) @db.Decimal(14, 2)
  remainingPayableEur    Decimal @default(0) @db.Decimal(14, 2)
  totalReceivableRon     Decimal @default(0) @db.Decimal(14, 2)
  totalReceivableEur     Decimal @default(0) @db.Decimal(14, 2)
  totalCollectedRon      Decimal @default(0) @db.Decimal(14, 2)
  totalCollectedEur      Decimal @default(0) @db.Decimal(14, 2)
  remainingReceivableRon Decimal @default(0) @db.Decimal(14, 2)
  remainingReceivableEur Decimal @default(0) @db.Decimal(14, 2)
  payableRows         Int      @default(0)
  receivableRows      Int      @default(0)
  issueCount          Int      @default(0)
  calculatedAt        DateTime @default(now())

  upload FinancialReportUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@index([companyCode])
  @@map("portfolio_financial_company_snapshots")
}

model FinancialPayable {
  id                  String   @id @default(cuid())
  uploadId            String
  supplierId          String?
  companyName         String
  companyCode         String?
  supplierName        String?
  invoiceNumber       String?
  normalizedInvoiceNumber String?
  invoiceDate         DateTime?
  documentDescription String?  @db.Text
  dueDate             DateTime?
  amountToPay         Decimal? @db.Decimal(14, 2)
  amountPaid          Decimal? @db.Decimal(14, 2)
  remainingAmount     Decimal? @db.Decimal(14, 2)
  paidAt              DateTime?
  paymentMethod       String?
  paymentNotes        String?  @db.Text
  currency            String?  @db.VarChar(3)
  status              String   @default("needs_review")
  rawRowJson          Json?
  needsReview         Boolean  @default(false)
  includedInReport    Boolean  @default(true)
  rowType             String?
  reviewNote          String?  @db.Text
  reviewedByUserId    String?
  reviewedAt          DateTime?
  excludeReason       String?  @db.Text
  createdAt           DateTime @default(now())

  upload FinancialReportUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("FinancialPayableReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  documents ClientDocument[] @relation("PayableDocuments")

  @@index([uploadId])
  @@index([supplierId])
  @@index([companyCode])
  @@index([supplierName])
  @@index([normalizedInvoiceNumber])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([status])
  @@index([needsReview])
  @@index([currency])
  @@index([includedInReport])
  @@index([reviewedByUserId])
  @@map("portfolio_financial_payables")
}

model FinancialReceivable {
  id              String   @id @default(cuid())
  uploadId        String
  clientId        String?
  campaignId      String?
  billingItemId   String?
  accountOwnerUserId String?
  companyName     String
  companyCode     String?
  invoiceNumber   String?
  normalizedInvoiceNumber String?
  canonicalKey    String?  @unique
  invoiceDate     DateTime?
  location        String?  @db.Text
  campaignDetails String?  @db.Text
  clientName      String?
  dueDate         DateTime?
  invoicedAmount  Decimal? @db.Decimal(14, 2)
  collectedAmount Decimal? @db.Decimal(14, 2)
  remainingAmount Decimal? @db.Decimal(14, 2)
  collectedAt     DateTime?
  paymentMethod   String?
  collectionNotes String?  @db.Text
  currency        String?  @db.VarChar(3)
  status          String   @default("needs_review")
  rawRowJson      Json?
  needsReview     Boolean  @default(false)
  includedInReport Boolean @default(true)
  rowType         String?
  reviewNote      String?  @db.Text
  reviewedByUserId String?
  reviewedAt      DateTime?
  excludeReason   String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastReportDate  DateTime?
  lastImportedAt  DateTime?

  upload FinancialReportUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  client ClientAccount? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  billingItem BillingItem? @relation(fields: [billingItemId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("FinancialReceivableReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  documents ClientDocument[] @relation("ReceivableDocuments")
  payments FinancialReceivablePayment[]
  importRows FinancialReceivableImportRow[]
  credits FinancialClientCredit[]

  @@index([uploadId])
  @@index([clientId])
  @@index([campaignId])
  @@index([billingItemId])
  @@index([accountOwnerUserId])
  @@index([companyCode])
  @@index([normalizedInvoiceNumber])
  @@index([companyCode, normalizedInvoiceNumber, currency])
  @@index([clientId, dueDate])
  @@index([invoiceDate])
  @@index([clientName])
  @@index([dueDate])
  @@index([status])
  @@index([needsReview])
  @@index([currency])
  @@index([includedInReport])
  @@index([reviewedByUserId])
  @@map("portfolio_financial_receivables")
}

model FinancialReceivableImportRow {
  id                      String   @id @default(cuid())
  uploadId                String
  receivableId            String?
  clientId                String?
  campaignId              String?
  locationId              String?
  companyName             String
  companyCode             String
  sheetName               String
  rowNumber               Int
  sourceRowKey            String
  sourceHash              String
  rawInvoiceNumber        String?
  normalizedInvoiceNumber String?
  invoiceDate             DateTime?
  dueDate                 DateTime?
  currency                String?  @db.VarChar(3)
  invoiceAmount           Decimal? @db.Decimal(14, 2)
  reportCollectedAmount   Decimal? @db.Decimal(14, 2)
  reportRemainingAmount   Decimal? @db.Decimal(14, 2)
  locationText            String?  @db.Text
  campaignDetails         String?  @db.Text
  clientNameRaw           String?
  normalizedClientName    String?
  status                  String   @default("pending")
  confidenceLevel         String   @default("unmatched")
  confidenceScore         Int      @default(0)
  matchReason             String?  @db.Text
  proposedAction          String?
  resolutionAction        String?
  resolutionReason        String?  @db.Text
  resolvedByUserId        String?
  resolvedAt              DateTime?
  rawRowJson              Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  upload     FinancialReportUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  receivable FinancialReceivable?   @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  client     ClientAccount?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaign   Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  location   Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  resolvedBy User?                  @relation("FinancialReceivableImportRowResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  payments   FinancialReceivablePayment[]

  @@unique([uploadId, sourceRowKey])
  @@index([uploadId, status])
  @@index([sourceHash])
