# Copy this file to .env.local and fill the real secrets.
# Do not commit .env.local.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=33306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-real-password
MYSQL_DATABASE=focus_preview_local

# Local synthetic development only. For remote databases verify TLS using the
# provider CA (sslaccept=strict&sslcert=/absolute/path/provider-ca.pem).
DATABASE_URL="mysql://root:replace-with-real-password@127.0.0.1:33306/focus_preview_local?connection_limit=5&pool_timeout=10"

ADMIN_EMAIL=admin@focusmedia.ro
ADMIN_PASSWORD=replace-with-strong-admin-password
BOOTSTRAP_ADMIN_EMAIL=admin@focusmedia.ro
BOOTSTRAP_ADMIN_PASSWORD=replace-with-one-time-bootstrap-password
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_MFA_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
AUTH_TRUSTED_ORIGINS=
AUTH_EMAIL_DELIVERY_ENABLED=false
MFA_ENFORCEMENT_MODE=off
MFA_REQUIRED_ROLES=SUPER_ADMIN,COO
MFA_GRACE_UNTIL=

NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_PHONE=40740052553

# Optional daily notification email digest. The app stays functional when omitted.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="Focus Media <notificari@focusmedia.ro>"
CRON_SECRET=replace-with-a-long-random-secret

# Preview/Staging safety gates. Keep ALLOW_SYNTHETIC_SEED=false in production.
APP_ENV=development
ALLOW_SYNTHETIC_SEED=false
PREVIEW_DATASET_ID=focus-media-synthetic-v1
PREVIEW_TEST_PASSWORD=replace-only-in-an-isolated-preview-environment

# Assignment pilot. Enable only in an isolated Preview or for an approved production pilot.
# This does not enable the legacy OperationTask read/write flags.
OPERATIONAL_ASSIGNMENT_ENABLED=false

# SAGA foundation. Fixture mode is read-only and must be used only in Development/Preview.
# Production remains disabled until the official read/write contract and legal-entity credentials are approved.
SAGA_SHADOW_MODE=disabled
SAGA_PRODUCT=

# Sales AI and external delivery stay disabled until the owner approves a
# commercial policy in /admin/ai and configures the relevant provider.
AI_SALES_GENERATION_ENABLED=false
AI_SALES_MODEL=
COMMERCIAL_SEND_ENABLED=false
COMMERCIAL_FROM_EMAIL=
COMMERCIAL_WEBHOOK_SECRET=

# Dedicated 32-byte random base64 recovery key, escrowed separately from backup.
# Never reuse AUTH_SECRET or store this key beside an archive.
BACKUP_ENCRYPTION_KEY=
BACKUP_MYSQL_CA_FILE=
EXTERNAL_MONITORING_CONFIGURED=false

# Release-only opt-ins. Never enable these by default in a shared environment.
APPLY_REMEDIATION_SCHEMA=false
RUN_REMEDIATION_SCHEMA_CHECK=false
REMEDIATION_DATABASE_FINGERPRINT=
