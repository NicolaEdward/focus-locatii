  approvalReference String @db.VarChar(500)
  requestKey     String   @unique @db.VarChar(120)
  payloadHash    String   @db.VarChar(64)
  createdByUserId String
  profileSnapshot Json
  createdAt      DateTime @default(now())
  @@index([profileId, periodStart, periodEnd, state])
  @@map("portfolio_dooh_capacity_bookings")
}

